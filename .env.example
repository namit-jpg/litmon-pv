# Database — default SQLite for local pilot; use Postgres in shared environments
DATABASE_URL=sqlite:///./litmon.db
# DATABASE_URL=postgresql+psycopg://litmon:litmon@localhost:5432/litmon

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# NCBI PubMed E-utilities (free public API)
NCBI_EMAIL=your.email@company.com
NCBI_API_KEY=
NCBI_TOOL=litmon-pv
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# LLM screening (OpenAI-compatible; SpaceXAI or other)
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-2-latest
# Set true to use deterministic mock scorer (no LLM key needed)
LLM_MOCK=true

# Literature assistant (the Chat tab). Answers via the Anthropic API using
# LLM_API_KEY, and needs a model supporting citations and structured outputs —
# that is what ties each sentence of an answer to the abstract it came from.
# ASSISTANT_EFFORT applies only to families exposing the effort ladder (Opus 5,
# Sonnet 5); it is ignored on Haiku 4.5, which uses a fixed thinking budget.
ASSISTANT_MODEL=claude-haiku-4-5
ASSISTANT_EFFORT=high

# CDSCO / NCC-PvPI E2B(R2) export
# The ICH ICSR v2.1 DTD is NOT shipped with this repo (ICH forbids commercial
# redistribution). Fetch your own copy, then point this at it so every export
# is DTD-validated at generation time:
#   python scripts/validate_cdsco_xml.py --fetch-dtd ./ich-icsr-v2.1.dtd
CDSCO_DTD_PATH=
CDSCO_SENDER_ID=LITMON-PV-PILOT
CDSCO_RECEIVER_ID=NCC-PvPI-CDSCO
# Prototype, data-driven validation registry. Replace only after the partner
# supplies the official mandatory-field specification. Output remains clearly
# labelled as non-validated and is never transmitted automatically.
REGULATORY_MANDATORY_FIELDS_JSON=[{"field":"pmid","label":"PMID","required":true},{"field":"suspect_products","label":"Suspect product(s)","required":true},{"field":"adverse_events","label":"Adverse event terms","required":true}]

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CLEAR_QC_SAMPLE_RATE=0.10
LOG_LEVEL=INFO
